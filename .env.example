# ============================================================
# auto-trading-engine — Environment Variables
# Copy to .env and fill in actual values
# NEVER commit .env to git
# ============================================================

# Trading mode: "paper" (simulation) or "live" (real money)
# Always start with paper mode to verify behavior
TRADING_MODE=paper

# API authentication (strong random string for production)
API_KEY=change-me-to-a-strong-random-string

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=auto_investing
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ── 키움증권 REST API ────────────────────────────────────────
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_ACCOUNT_NO=          # 계좌번호 (예: 12345678)

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Discord Webhook ─────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Risk Guard ──────────────────────────────────────────────
# 일일 최대 손실 (KRW) — 초과 시 자동 거래 중단
RISK_MAX_DAILY_LOSS_KRW=500000
# 최대 동시 보유 종목 수
RISK_MAX_POSITION_COUNT=5
# 종목당 최대 투자금액 (KRW)
RISK_MAX_POSITION_KRW=1000000
# 포트폴리오 대비 최대 비중 (%)
RISK_MAX_POSITION_PCT=20.0
# 최소 신호 신뢰도: HIGH, MEDIUM-HIGH, MEDIUM, LOW
RISK_MIN_CONFIDENCE=MEDIUM-HIGH

# ── Application ─────────────────────────────────────────────
LOG_LEVEL=INFO
